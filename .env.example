# Local development only — replace all secrets outside local machines.
POSTGRES_DB=serpent
POSTGRES_USER=serpent
POSTGRES_PASSWORD=serpent_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://serpent:serpent_dev_only@127.0.0.1:5432/serpent
REDIS_URL=redis://127.0.0.1:6379

API_PORT=8080
PORT=2567
SERPENT_GAME_ENDPOINT=ws://127.0.0.1:2567
SERPENT_CONFIG_URL=http://127.0.0.1:8080/v1/config/client
SERPENT_CONFIG_ROLLOUT_KEY=local-game-server-1
# API가 잠시 중단되어도 게임 결과를 재시작 뒤 재전송하려면 영속 볼륨 경로를 지정합니다.
SERPENT_RESULT_OUTBOX_PATH=./data/result-outbox.json
# Room tick P99가 지속 초과하면 신규 매치를 자동 drain합니다.
SERPENT_TICK_DRAIN_P99_MS=80
SERPENT_TICK_DRAIN_SUSTAIN_MS=300000
# P1 tick 지속 초과와 P2 결과 outbox backlog 경보 임계값입니다.
SERPENT_TICK_ALERT_P99_MS=45
SERPENT_TICK_ALERT_SUSTAIN_MS=300000
SERPENT_SNAPSHOT_ALERT_P95_BYTES=4096
SERPENT_EVENT_LOOP_DRAIN_P99_MS=80
SERPENT_EVENT_LOOP_DRAIN_SUSTAIN_MS=300000
# SIGTERM 후 drain을 유지하는 최대 시간. Kubernetes terminationGracePeriodSeconds보다 작게 둡니다.
SERPENT_SHUTDOWN_DRAIN_TIMEOUT_MS=110000
# Kubernetes Deployment에서만 1: SIGTERM 시 Room drain 뒤 종료합니다.
SERPENT_GRACEFUL_SHUTDOWN=0
SERPENT_RESULT_BACKLOG_ALERT=100
# Room은 최대 30분 뒤 신규 매칭을 drain해 장시간 세션 누적을 막습니다.
SERPENT_ROOM_MAX_AGE_MS=1800000
SERPENT_CORS_ORIGIN=http://127.0.0.1:5173
# 운영 HTTPS에서는 refresh token을 JSON/localStorage 대신 HttpOnly Secure cookie로 발급합니다.
SERPENT_REFRESH_COOKIE=0

# Use unique values in every shared environment. Never commit production values.
SERPENT_TOKEN_SECRET=replace-me
SERPENT_INTERNAL_SECRET=replace-me
SERPENT_ADMIN_SECRET=replace-me
# 선택: viewer/operator/owner 역할별 관리자 비밀 JSON. 기존 ADMIN_SECRET은 owner 호환 경로입니다.
SERPENT_ADMIN_ROLE_SECRETS={}
# base32 TOTP secret. 운영(NODE_ENV=production)에서는 관리자 API에 필수입니다.
SERPENT_ADMIN_TOTP_SECRET=
SERPENT_GAME_OPS_ENDPOINT=http://127.0.0.1:2567
SERPENT_GAME_OPS_SECRET=replace-me
# 1이면 Fastify의 JSON 요청 로그(reqId, method, status, latency)를 켭니다.
SERPENT_REQUEST_LOG=0
# 쉼표 또는 줄바꿈으로 추가 금칙어를 지정합니다. 기본 보호 목록은 항상 유지됩니다.
SERPENT_BANNED_WORDS=
