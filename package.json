{
  "name": "serpent-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check:web-budget": "node scripts/check-web-budget.mjs",
    "check:assets": "node scripts/check-assets-manifest.mjs",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "test:determinism": "pnpm --filter @serpent/game-core test:determinism",
    "test:authority": "pnpm --filter @serpent/game-server test:authority",
    "test:aoi": "pnpm --filter @serpent/game-server test:aoi",
    "smoke": "bash scripts/smoke.sh",
    "test:netem": "pnpm --filter @serpent/web test:netem",
    "test:soak": "pnpm --filter @serpent/game-core test:soak",
    "test:soak:6h": "bash scripts/soak.sh 6",
    "test:soak:24h": "bash scripts/soak.sh 24",
    "test:bots": "pnpm --filter @serpent/game-server test:bots",
    "test:tick-budget": "pnpm --filter @serpent/game-server test:tick-budget",
    "test:api": "pnpm --filter @serpent/api test",
    "test:matchmaker": "pnpm --filter @serpent/game-server test:matchmaker",
    "test:e2e": "node scripts/e2e.mjs",
    "infra:check": "bash scripts/check-infra.sh",
    "infra:check:kubernetes": "bash scripts/check-kubernetes.sh",
    "local": "bash scripts/run-local.sh",
    "smoke:postgres": "pnpm --filter @serpent/api exec tsx src/postgres.smoke.ts",
    "smoke:redis": "pnpm --filter @serpent/api exec tsx src/redis.smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "colyseus.js": "^0.16.22",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  },
  "pnpm": {
    "overrides": {
      "@colyseus/core": "0.16.24",
      "@colyseus/ws-transport": "0.16.5",
      "@colyseus/schema": "3.0.76",
      "@colyseus/auth": "0.16.6",
      "colyseus": "0.16.5",
      "colyseus.js": "0.16.22"
    }
  }
}
